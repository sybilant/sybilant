#!/usr/bin/env bash
# Builds and runs each assembly test as a standalone program.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

green=$'\033[32m'
red=$'\033[31m'
bold=$'\033[1m'
reset=$'\033[0m'
test_timeout=5s

shopt -s globstar nullglob
tests=("$root"/test/**/*_test.asm)

if ((${#tests[@]} == 0)); then
  echo "No *_test.asm files found under test/." >&2
  exit 1
fi

make --no-print-directory -C "$root" build-tests || exit 1

passed=0
failed=0

for source in "${tests[@]}"; do
  relative="${source#"$root/"}"
  test_name="${relative#test/}"
  test_name="${test_name%.asm}"
  executable="$root/build/test/executables/$test_name"

  timeout --kill-after=1s "$test_timeout" "$executable"
  status=$?

  if ((status == 0)); then
    printf '%s✓%s %s\n' "$green" "$reset" "$relative"
    ((passed += 1))
  elif ((status == 124)); then
    printf '%s✗%s %s %s(timed out after %s)%s\n' \
      "$red" "$reset" "$relative" "$bold" "$test_timeout" "$reset"
    ((failed += 1))
  else
    printf '%s✗%s %s %s(exit status %d)%s\n' \
      "$red" "$reset" "$relative" "$bold" "$status" "$reset"
    ((failed += 1))
  fi
done

echo
echo "$passed passed; $failed failed"

((failed == 0))
